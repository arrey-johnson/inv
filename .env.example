# =============================================================================
# Promptstack Invoicing - environment variables
# Copy to `.env.local` for development. NEVER commit real values.
# =============================================================================

# --- Supabase (Project settings -> API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public anon / publishable key (safe for the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SERVER ONLY. Bypasses RLS. Never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo mode (no Supabase needed) -----------------------------------------
# DEMO_MODE=true runs the whole app against a local JSON file in .data/ with a built-in demo admin
# (no login). Clearly badged in the UI. NEVER enable in production.
# DEMO_ROLE=admin|accountant|sales|viewer lets you try the permission matrix.
DEMO_MODE=false
DEMO_ROLE=admin

# --- App ---------------------------------------------------------------------
# Public base URL (used to build secure document links and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Default organization (seeded by supabase/migrations/00009_seed_defaults.sql)
DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

# --- Secure document links ---------------------------------------------------
# HMAC secret (>= 32 chars) used to hash public link tokens. Rotating it invalidates all existing links.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
DOCUMENT_LINK_SECRET=

# --- Branding assets (letterhead + stamp) ------------------------------------
# local   -> read assets/branding/source/*  (development)
# storage -> read the private Supabase Storage bucket `branding` (production)
BRANDING_SOURCE=local

# --- Email --------------------------------------------------------------------
# none   -> sending is disabled; the UI says so and logs a "failed" entry (nothing is faked)
# resend -> real delivery through Resend (needs RESEND_API_KEY and a verified sender domain)
# smtp   -> NOT implemented yet (behaves like none and says so)
# In DEMO_MODE with EMAIL_PROVIDER=none, messages are written to .data/outbox/ and logged as "queued" -
# they are NEVER delivered and the UI never claims they were.
EMAIL_PROVIDER=none
EMAIL_FROM="Promptstack Technologies <invoices@example.com>"
RESEND_API_KEY=
